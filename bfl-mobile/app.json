{
  "expo": {
    "name": "BFL Fitness",
    "slug": "bfl-mobile",
    "scheme": "bflfitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171717"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bflfitness.app"
    },
    "android": {
      "package": "com.bflfitness.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BFL Fitness to access your photos for progress logs and check-ins.",
          "cameraPermission": "Allow BFL Fitness to use your camera for check-in photos."
        }
      ]
    ]
  }
}
