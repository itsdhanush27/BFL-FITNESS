# Backend API URL for server-side Stripe operations
# For local physical device testing with Expo Go, use your computer's LAN IP:
# EXPO_PUBLIC_API_URL="http://192.168.1.2:3000"
#
# For production Android APK builds & GitHub Releases, use your live backend / Vercel URL:
EXPO_PUBLIC_API_URL="https://your-project-name.vercel.app"

# Optional client-side publishable key (never put secret keys in mobile apps)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
