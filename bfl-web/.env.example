# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this web application is hosted.
APP_URL="http://localhost:3000"
PORT=3000

# Backend API URL for client requests (defaults to window.location.origin)
VITE_API_URL="http://localhost:3000"

# STRIPE SERVER-SIDE CREDENTIALS (Server only — never prefix with VITE_)
STRIPE_SECRET_KEY="your_stripe_secret_key_here"

# Optional Client-side Stripe Publishable Key
VITE_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key_here"
